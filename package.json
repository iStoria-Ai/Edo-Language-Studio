{
  "name": "edo-language-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Edo Language Studio — Community-powered Android & iOS application to preserve and teach the Edo language of Nigeria.",
  "type": "module",
  "scripts": {
    "test": "node tests/storage.cjs",
    "audio:generate": "node scripts/generate-kokoro-audio.mjs",
    "dev": "vite --port 5173",
    "build": "tsc && vite build",
    "build:getrodion": "tsc && vite build --mode getrodion",
    "build:cap": "tsc && vite build --mode capacitor",
    "preview": "vite preview --port 4173",
    "cap:sync": "npm run build:cap && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "6.0.4",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "kokoro-js": "^1.2.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
